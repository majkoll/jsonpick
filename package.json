{
  "name": "jsonpick",
  "version": "0.1.0",
  "description": "A command-line tool for reading values from JSON.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "jsonpick": "./dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "json",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./package.json": "./package.json"
  }
}
